# ── Sats Card Backend Configuration ────────────────────────────────
# Copy this file to .env and fill in your values

# App
APP_NAME=Sats Card API
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-this-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./satscard.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/satscard

# ── MTN Mobile Money (MoMo API) ────────────────────────────────
# Get from: https://momodeveloper.mtn.co.rw
MTN_MOMO_API_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_SECRET=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_CALLBACK_URL=https://yourdomain.com/api/webhooks/mtn
MTN_MOMO_COUNTRY=rw

# ── Airtel Money API ────────────────────────────────────────────
# Get from: https://developer.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_BASE_URL=https://openapi.airtel.africa

# ── Orange Money API ────────────────────────────────────────────
# Get from: https://developer.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_ENVIRONMENT=sandbox
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1

# ── MPESA (Safaricom Daraja API) ───────────────────────────────
# Get from: https://developer.safaricom.co.ke
# 1. Create account at developer.safaricom.co.ke
# 2. Create an app in the portal
# 3. Get Consumer Key and Consumer Secret
# 4. For Paybill: Get Short Code and Passkey
# 5. Set callback URL in the portal
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://yourdomain.com/api/webhooks/mpesa

# ── Africa's Talking (USSD + SMS) ──────────────────────────────
# Get from: https://africastalking.com
# 1. Create account
# 2. Create USSD app in dashboard
# 3. Set callback URL to: https://yourdomain.com/api/at/ussd
# 4. Register a service code (e.g. *123#)
AT_API_KEY=
AT_USERNAME=sandbox
AT_ENVIRONMENT=sandbox

# ── Strike (Bitcoin Lightning Network) ──────────────────────────
# Get from: https://strike.me
# 1. Create account at strike.me
# 2. Go to Settings > API Keys
# 3. Generate a new API key
# 4. For sandbox, use test API key
STRIKE_API_KEY=
STRIKE_ENVIRONMENT=sandbox

# ── Exchange Rate ───────────────────────────────────────────────
BTC_PRICE_FEED_URL=https://api.coingecko.com/api/v3/simple/price
PRICE_CACHE_TTL_SECONDS=30

# ── SMS Gateway ─────────────────────────────────────────────────
SMS_PROVIDER=africastalking
SMS_API_KEY=
SMS_SENDER_ID=SATSCARD

# ── USSD ────────────────────────────────────────────────────────
USSD_SESSION_TIMEOUT_SECONDS=180
USSD_SHORT_CODE=*123#
